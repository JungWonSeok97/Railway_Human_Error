+        // 문항마다 보기를 독립적으로 고른다. 모든 조합을 만든 뒤 하나를 고르는 것과 같은 균등 분포이고,
+        // 조합 수(환경 문항은 수십만 개)만큼 메모리를 쓰지 않는다.
+        const selectedScenario = listsToCombing.map(
