@@ -94,8 +78,11 @@ export default function SurveyForm({ questionIds, groupName }: SurveyFormProps)
         const listsToCombing = keysForThisQ.map((key: string) => ALL_OPTION_LISTS[key as keyof typeof ALL_OPTION_LISTS]);
         
